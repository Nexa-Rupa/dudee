# Keys stay on your machine. You can also paste them in the web app (Settings → Models)
# or run `dude keys set <provider>`; those are saved in .dude/secrets.env instead.
# Set at least one model provider.

ANTHROPIC_API_KEY=            # anthropic:claude-opus-5-5
OPENAI_API_KEY=               # openai:gpt-5, openai:gpt-5-codex
GOOGLE_GENERATIVE_AI_API_KEY= # google:gemini-2.5-pro
GROQ_API_KEY=                 # groq:openai/gpt-oss-120b
OPENROUTER_API_KEY=           # openrouter:openrouter/auto (any model from any lab)
DEEPSEEK_API_KEY=             # deepseek:deepseek-chat
MOONSHOT_API_KEY=             # moonshot:kimi-k2-0905-preview
ZAI_API_KEY=                  # zai:glm-4.6
DASHSCOPE_API_KEY=            # qwen:qwen3-max
XAI_API_KEY=                  # xai:grok-4
MISTRAL_API_KEY=              # mistral:mistral-large-latest
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
# Local, no key needed: ollama:<model>, lmstudio:<model>, 9router:<model>
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NINEROUTER_BASE_URL=http://localhost:20128/v1
# NINEROUTER_API_KEY=

# Media and tools (optional)
FAL_KEY=                      # images and video for the Content Creator
BRAVE_API_KEY=                # better web search (falls back to DuckDuckGo)
TAVILY_API_KEY=
VAPI_API_KEY=                 # phone calls for the Calling Agent
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
