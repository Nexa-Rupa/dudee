{
  "name": "@dude/core",
  "version": "0.1.0",
  "description": "Runtime for open-source AI employees: agent loop, tools, approvals, memory, routines.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "dude-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions=dude-source --test test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.115",
    "@ai-sdk/google": "2.0.111",
    "@ai-sdk/openai": "2.0.143",
    "@ai-sdk/openai-compatible": "1.0.63",
    "@modelcontextprotocol/sdk": "1.20.2",
    "ai": "5.0.289",
    "croner": "9.1.0",
    "yaml": "2.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@dude/employees": "workspace:*"
  }
}
